rules_version = '2';
// 陶笛回家練習｜Firestore 安全規則
// 貼到 Firebase 控制台 → Firestore Database → 規則 → 發佈。
// ⚠️ 管理者 email 清單（下面 isAdmin）要和 firebase-config.js 的 adminEmails 一樣。
//
// 資料：
//   students/{key}  學生。key＝「姓名＋分部」的 SHA-256 前 24 碼（見 student-auth.js）；欄位 name、group、ack、created、uid
//   alias/{key}     分部改名／合併後的別名 { key: 原本學生的 key }；登入前要查，任何人能讀單一文件，只有管理者能寫
//   gens/{key}      密碼重設的世代 { g: 數字 }；登入前要查，任何人能讀單一文件，只有管理者能寫
//   tasks/{id}      老師的每週任務；已登入的學生能讀，只有管理者能寫
//   pub/groups      目前有哪些分部 { groups: [...] }；登入頁的建議清單，任何人能讀，只有管理者能寫
//   settings/config 放寬設定；已登入者能讀，只有管理者能寫
//   logs/{id}       每次過關一筆；id＝<學生key>_<任務id>_<第幾天>_<第幾次>，只能新增、不能改不能刪，
//                   同一人同一任務同一天最多 5 筆（id 的最後一碼 k ≤ 5，同一個 id 只能建立一次）；學生只能讀自己的
//   adj/{id}        老師手動加減積分；學生能讀自己的，只有管理者能寫
//
// 學生帳號的 email 是「<key>[-世代]@op-students.example.com」，所以 key 可以從 email 取出，用來限制「只能寫自己的」。
// 老師另外用一般的 Email／密碼帳號登入（不是學生網域）。
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['a0929870116@gmail.com', 'efland95@gmail.com'];
    }
    function signedIn() {
      return request.auth != null;
    }
    function isStudentAcct() {
      return signedIn() && request.auth.token.email.matches('.*@op-students[.]example[.]com');
    }
    // 目前登入學生的 key（email @ 前面、「-」前面那段）
    function myKey() {
      return request.auth.token.email.split('@')[0].split('-')[0];
    }
    // 台北時間的「第幾天」（和 core.js 的 todayDay 算法一樣）
    function dayNow() {
      return math.floor((request.time.toMillis() + 28800000) / 86400000);
    }
    function myDoc() {
      return get(/databases/$(database)/documents/students/$(myKey()));
    }

    // ---- 登入前要查的：任何人能讀單一文件（不能列出）----
    match /gens/{key} {
      allow get: if true;
    }
    match /alias/{key} {
      allow get: if true;
    }
    // 登入頁的「分部」建議清單（老師後台自動更新）；任何人能讀
    match /pub/{id} {
      allow get: if true;
    }

    // ---- 學生 ----
    match /students/{sid} {
      // 只能讀自己的
      allow get: if signedIn() && resource.data.get('uid', null) == request.auth.uid;

      // 建立自己的：文件 id 必須等於自己帳號的 key；一定要勾「已告知家長」；欄位固定
      allow create: if isStudentAcct()
        && sid == myKey()
        && request.resource.data.keys().hasOnly(['name', 'group', 'ack', 'created', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ack == true
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.group is string
        && request.resource.data.group.size() >= 1
        && request.resource.data.group.size() <= 20
        && request.resource.data.group != '全部'
        && request.resource.data.created is string && request.resource.data.created.size() <= 40;

      // 認領：名單上已有這位、而且 uid 是空的（老師剛重設），只能把 uid 改成自己、ack 設為 true
      allow update: if isStudentAcct()
        && sid == myKey()
        && resource.data.get('uid', null) == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ack == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'ack']);
    }

    // ---- 任務與設定：學生只能讀 ----
    match /tasks/{id} {
      allow get, list: if isStudentAcct();
    }
    match /settings/{id} {
      allow get: if signedIn();
    }

    // ---- 練習紀錄：只能新增自己的，欄位固定，不能改不能刪 ----
    match /logs/{id} {
      allow get, list: if isStudentAcct() && resource.data.sid == myKey();
      allow create: if isStudentAcct()
        && request.resource.data.keys().hasOnly(['sid', 'task', 'day', 'k', 'pct', 'ts'])
        && request.resource.data.sid == myKey()
        && request.resource.data.task is string
        && request.resource.data.task.size() >= 1 && request.resource.data.task.size() <= 40
        && request.resource.data.day is int
        && request.resource.data.day == dayNow()
        && request.resource.data.k is int
        && request.resource.data.k >= 1 && request.resource.data.k <= 5
        && request.resource.data.pct is int
        && request.resource.data.pct >= 30 && request.resource.data.pct <= 100
        && request.resource.data.ts == request.time
        && id == myKey() + '_' + request.resource.data.task + '_' + string(request.resource.data.day) + '_' + string(request.resource.data.k)
        && exists(/databases/$(database)/documents/tasks/$(request.resource.data.task))
        && myDoc().data.get('uid', null) == request.auth.uid;
    }

    // ---- 老師手動加減積分：學生只能讀自己的 ----
    match /adj/{id} {
      allow get, list: if isStudentAcct() && resource.data.sid == myKey();
    }

    // ---- 管理者：全部可讀寫（含刪除）；其餘一律拒絕 ----
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
